# Ứng dụng
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cơ sở dữ liệu — dữ liệu của web giữ ở SQLite (file shop.db trong apps/api),
# dùng node:sqlite có sẵn trong Node, không cần cài thêm hay chạy Docker.
DATABASE_URL=file:./shop.db

# Redis — để trống thì dùng cache trong bộ nhớ (cùng một giao diện).
# Khi chạy bằng Docker Compose: REDIS_URL=redis://redis:6379
# Khi chạy ở máy local có Redis: REDIS_URL=redis://localhost:6379
REDIS_URL=

# LLM — OpenAI. Chỉ cần thay 2 dòng dưới là agent dùng OpenAI thật,
# không cần sửa code ở nơi khác.
# (a) Không có key: agent chạy ở chế độ local — RAG dùng TF-IDF, Qdrant local
#     (nếu có QDRANT_URL) dùng localEmbedding, câu trả lời vẫn có citation.
# (b) Chỉ cần điền OPENAI_API_KEY và chọn OPENAI_MODEL là chạy được OpenAI thật;
#     embedding dùng EMBEDDING_MODEL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector DB — Qdrant, nơi RAG lưu knowledge (chunk đã embedding).
# (c) Khi chạy bằng Docker Compose: QDRANT_URL=http://qdrant:6333
#     Khi chạy Qdrant ở máy local: QDRANT_URL=http://localhost:6333
#     Để trống QDRANT_URL thì RAG chỉ dùng tìm kiếm local TF-IDF trên SQLite.
#     Qdrant local thường không cần key; Qdrant Cloud mới cần QDRANT_API_KEY.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=shop_knowledge

# Xác thực
JWT_SECRET=doi-secret-nay-truoc-khi-chay-that

# Ngân sách AI (USD)
AI_DAILY_BUDGET_USD=20
AI_MONTHLY_BUDGET_USD=300

# MCP Server gọi API bằng token dịch vụ nội bộ (không phải token của người dùng)
MCP_SERVICE_TOKEN=doi-mcp-service-token-nay
